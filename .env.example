# Host filesystem path with Katka's original TVSD recordings (read-only).
TVSD_SOURCE=/CSNG/Ephys_data/Macaque_data/TVSD_data

# Host directory for COPIED SELECTED DATA, caches, results and checkpoints.
# This may be an absolute path on your large disk. Create it before starting.
# Example: /mnt/large-disk/sinz_tvsd_data
TVSD_WORKDIR=./data

# `id -u` / `id -g` on the Docker host. Must have write access to WORKDIR.
TVSD_UID=1000
TVSD_GID=1000
