#!/bin/bash
#PBS -N tvsd_zwm_ridge
#PBS -q gpu
#PBS -l select=1:ncpus=4:mem=48gb:ngpus=1:scratch_local=10gb
#PBS -l walltime=12:00:00
set -euo pipefail
ROOT=/storage/brno2/home/jonas_prokop/visual_models
CODE="$ROOT/code/papala_tsvd_trainer"
SIF="$ROOT/containers/tvsd-bookworm.sif"
PYTHON=/mnt/tvsd/envs/zwm-py310/bin/python
: "${CANDIDATE_ID:?Pass CANDIDATE_ID using qsub -v}"
: "${PBS_JOBID:?Run through PBS}"
: "${SCRATCHDIR:?requires scratch_local}"
for item in "$SIF" "$ROOT/envs/zwm-py310/bin/python" "$ROOT/data/tvsd_waveform_aware_v1/model_dataset/dataset_info.json"; do
  [ -f "$item" ] || { echo "Missing file: $item" >&2; exit 2; }
done
[ -d "$ROOT/code/ZWM" ] || { echo 'Missing upstream ZWM checkout' >&2; exit 2; }
[ -d "$ROOT/data/assets/THINGS" ] || { echo 'Missing THINGS images' >&2; exit 2; }
mkdir -p "$ROOT/logs" "$ROOT/results" "$ROOT/cache/huggingface" "$ROOT/cache/torch"
exec > "$ROOT/logs/zwm.${PBS_JOBID}.log" 2>&1
export SINGULARITYENV_PYTHONPATH="/project:/mnt/tvsd/code/ZWM"
export SINGULARITYENV_PYTHONNOUSERSITE=1
export SINGULARITYENV_PYTHONUNBUFFERED=1
export SINGULARITYENV_CUDA_DEVICE_ORDER=PCI_BUS_ID
export SINGULARITYENV_HF_HOME=/mnt/tvsd/cache/huggingface
export SINGULARITYENV_HF_HUB_CACHE=/mnt/tvsd/cache/huggingface/hub
export SINGULARITYENV_HF_HUB_OFFLINE=1
export SINGULARITYENV_TRANSFORMERS_OFFLINE=1
export SINGULARITYENV_TORCH_HOME=/mnt/tvsd/cache/torch
export SINGULARITYENV_OPENBLAS_NUM_THREADS=4
export SINGULARITYENV_MKL_NUM_THREADS=4
export SINGULARITYENV_OMP_NUM_THREADS=4
# Preserve the established UUID -> CUDA index fix on PBS GPU allocations.
if [[ "${CUDA_VISIBLE_DEVICES:-}" == GPU-* && "${CUDA_VISIBLE_DEVICES}" != *,* ]]; then
  index=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader | \
          awk -F, -v uuid="$CUDA_VISIBLE_DEVICES" '{gsub(/^[ \t]+|[ \t]+$/, "", $1);gsub(/^[ \t]+|[ \t]+$/, "", $2); if ($2==uuid) print $1}')
  [[ "$index" =~ ^[0-9]+$ ]] || { echo 'Cannot resolve PBS GPU UUID' >&2; exit 4; }
  export SINGULARITYENV_CUDA_VISIBLE_DEVICES="$index"
fi
printf 'ZWM START host=%s job=%s python=%s image=%s\n' "$(hostname)" "$PBS_JOBID" "$PYTHON" "$SIF"
CENTRAL_DB="$ROOT/results/results.sqlite"
LOCAL_DB="$SCRATCHDIR/zwm_worker.sqlite"
HANDOFF_DIR="$ROOT/results/zwm_handoffs/$CANDIDATE_ID"
HANDOFF_DB="$HANDOFF_DIR/$PBS_JOBID.sqlite"
mkdir -p "$HANDOFF_DIR"
# Read central only to obtain a consistent seed. The compute node NEVER writes it.
python3 "$CODE/sinz_model/sqlite_snapshot.py" \
  --source "$CENTRAL_DB" --destination "$LOCAL_DB"
persist_worker() {
  if [ -f "$LOCAL_DB" ]; then
    python3 "$CODE/sinz_model/sqlite_snapshot.py" \
      --source "$LOCAL_DB" --destination "$HANDOFF_DB"
    printf 'ZWM handoff: %s\n' "$HANDOFF_DB"
  fi
}
RUN_PID=""
on_term() {
  trap - TERM
  echo "PBS TERM: asking ZWM to exit and capturing worker SQLite"
  if [ -n "$RUN_PID" ]; then
    kill -TERM "$RUN_PID" 2>/dev/null || true
    wait "$RUN_PID" || true
  fi
  persist_worker || true
  exit 143
}
trap on_term TERM
set +e
singularity exec --nv \
  --bind "$CODE:/project" \
  --bind "$ROOT:/mnt/tvsd" \
  --bind "$SCRATCHDIR:/worker" \
  "$SIF" "$PYTHON" -m transformer_model.launch \
    --sqlite-path /worker/zwm_worker.sqlite \
    --candidate-id "$CANDIDATE_ID" --member 0 &
RUN_PID=$!
wait "$RUN_PID"
rc=$?
set -e
trap - TERM
persist_worker
printf 'ZWM FINISH exit=%s job=%s\n' "$rc" "$PBS_JOBID"
exit "$rc"
